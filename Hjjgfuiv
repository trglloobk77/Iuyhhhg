FpsTab:CreateToggle({
    Name = "Low Graphics Mode",
    CurrentValue = Config.LowGraphics,
    Flag = "LowGraphicsToggle",
    Callback = function(Value)
        Config.LowGraphics = Value
        if Value then
            for _, v in pairs(Workspace:GetDescendants()) do
                if v:IsA("BasePart") and not v:IsA("MeshPart") then v.Material = Enum.Material.SmoothPlastic end
                if v:IsA("Decal") or v:IsA("Texture") then v:Destroy() end
            end
            Lighting.GlobalShadows = false
            Lighting.FogEnd = 100
        end
    end
})

