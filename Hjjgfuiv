function MiscSystem.StartAimbot()
    task.spawn(function()
        while Config.Aimbot do
            task.wait(0.1)
            pcall(function()
                local nearest = nil
                local minDist = math.huge
                
                for _, other in pairs(Players:GetPlayers()) do
                    if other ~= Player and other.Character then
                        local hrp = other.Character:FindFirstChild("HumanoidRootPart")
                        if hrp then
                            local dist = (hrp.Position - HumanoidRootPart.Position).Magnitude
                            if dist < minDist and dist < 200 then
                                minDist = dist
                                nearest = other
                            end
                        end
                    end
                end
                
                if nearest and nearest.Character then
                    local targetHRP = nearest.Character:FindFirstChild("HumanoidRootPart")
                    if targetHRP then
                        GlobalTween(targetHRP.CFrame * CFrame.new(0, 0, 5), 600)
                        EquipWeapon(Config.SelectedWeapon)
                        StartFastAttack()
                        for _, key in pairs({"Z", "X", "C", "V"}) do
                            VirtualInputManager:SendKeyEvent(true, key, false, game)
                            task.wait(0.05)
                            VirtualInputManager:SendKeyEvent(false, key, false, game)
                        end
                    end
                end
            end)
        end
    end)
end

