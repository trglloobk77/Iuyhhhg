end

local function StartBringMobs()
    if Threads.BringMobs then return end
    Threads.BringMobs = task.spawn(function()
        while Config.BringMobs do
            task.wait(0.1)
            pcall(function()
                if not CurrentQuest then return end
                for _, enemy in pairs(Workspace.Enemies:GetChildren()) do
                    if enemy.Name == CurrentQuest.Enemy then
                        local eHum = enemy:FindFirstChild("Humanoid")
                        local eHRP = enemy:FindFirstChild("HumanoidRootPart")
                        if eHum and eHRP and eHum.Health > 0 then
                            if (eHRP.Position - HumanoidRootPart.Position).Magnitude <= 150 then
                                for _, part in pairs(enemy:GetDescendants()) do
                                    if part:IsA("BasePart") then part.CanCollide = false end
                                end
                                if enemy:FindFirstChild("Ragdoll") then enemy.Ragdoll:Destroy() end
                                eHRP.CFrame = HumanoidRootPart.CFrame * CFrame.new(0, 0, -6)
                                eHRP.Velocity = Vector3.new(0, 0, 0)
                            end
                        end
                    end
                end
            end)
        end
    end)
end

local function StopBringMobs()
    if Threads.BringMobs then task.cancel(Threads.BringMobs); Threads.BringMobs = nil end
end

--// Auto Farm
local function StartAutoFarm()
    if Threads.AutoFarm then return end
    Threads.AutoFarm = task.spawn(function()
        while Config.AutoFarmLevel do
            task.wait(0.5)
            pcall(function()
                local level = Player.Data.Level.Value
                local quest = GetQuestForLevel(level)
                if not quest then task.wait(2); return end
                
                if not CurrentQuest or CurrentQuest.Level ~= quest.Level then
                    GlobalTween(quest.NPCPos, 300)
                    task.wait(0.8)
                    CommF_:InvokeServer("StartQuest", quest.Quest, quest.Level)
                    CurrentQuest = quest
                    task.wait(1)
                    return
                end
                
                local enemies = FindEnemies(CurrentQuest.Enemy)
                if #enemies > 0 then
                    local target = enemies[1]
                    local tHRP = target:FindFirstChild("HumanoidRootPart")
                    if tHRP then
                        local farmPos = tHRP.CFrame * CFrame.new(0, 0, Config.FarmDistance)
                        if (farmPos.Position - HumanoidRootPart.Position).Magnitude > 10 then
                            GlobalTween(farmPos, Config.FarmTweenSpeed)
                        end
                        EquipWeapon(Config.SelectedWeapon)
                        Camera.CFrame = CFrame.new(Camera.CFrame.Position, tHRP.Position)
                    end
                end
            end)
        end
    end)
end

local function StopAutoFarm()
    StopGlobalTween()
    if Threads.AutoFarm then task.cancel(Threads.AutoFarm); Threads.AutoFarm = nil end
    StopFastAttack()
    StopBringMobs()
end

