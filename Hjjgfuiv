local SeaSystem = {}

function SeaSystem.AutoDriveBoatZone6()
    task.spawn(function()
        CommF_:InvokeServer("BuyBoat", "Grand Brigade")
        task.wait(1)
        
        local boat = nil
        for _, v in pairs(Workspace:GetChildren()) do
            if v:IsA("Model") and v.Name:find("Boat") then
                local owner = v:FindFirstChild("Owner")
                if owner and owner.Value == Player then boat = v; break end
            end
        end
        
        if not boat then return end
        
        local seat = boat:FindFirstChildOfClass("VehicleSeat")
        if seat then
            HumanoidRootPart.CFrame = seat.CFrame
            task.wait(0.5)
            seat:Sit(Humanoid)
            task.wait(0.3)
            seat.Throttle = 1
            
            while Config.AutoDriveBoat do
                task.wait(0.5)
                local dangerGui = PlayerGui:FindFirstChild("Main")
                if dangerGui then
                    local dangerText = dangerGui:FindFirstChild("DangerLevel")
                    if dangerText then
                        local level = tonumber(dangerText.Text:match("%d+")) or 0
                        if level >= 6 then
                            seat.Throttle = 0
                            Rayfield:Notify({
                                Title = "Zone 6",
                                Content = "Đã đến Danger Level 6!",
                                Duration = 5
                            })
                            break
                        end
                    end
                end
            end
        end
    end)
end

function SeaSystem.StartSeaEvent()
    if Threads.SeaEvent then return end
    Threads.SeaEvent = task.spawn(function()
        while Config.AutoSeaEvent do
            task.wait(0.2)
            pcall(function()
                local targets = {}
                local seaEvents = Workspace:FindFirstChild("SeaEvents")
                if seaEvents then
                    for _, v in pairs(seaEvents:GetChildren()) do
                        if Config.SeaEventType == "All" or v.Name:find(Config.SeaEventType) then
                            if v.Name:find("Terrorshark") or v.Name:find("SeaBeast") or v.Name:find("Piranha") or v.Name:find("Ghost") then
                                table.insert(targets, v)
                            end
                        end
                    end
                end
                
                if Humanoid.SeatPart then
                    local boat = Humanoid.SeatPart.Parent
                    for _, part in pairs(boat:GetDescendants()) do
                        if part:IsA("BasePart") then part.CanCollide = false end
                    end
                end
                
                for _, target in pairs(targets) do
                    if not Config.AutoSeaEvent then break end
                    local tHRP = target:FindFirstChild("HumanoidRootPart") or target:FindFirstChild("Head")
                    local tHum = target:FindFirstChild("Humanoid")
                    if tHRP and tHum and tHum.Health > 0 then
                        GlobalTween(tHRP.CFrame * CFrame.new(0, 30, 0), 500)
                        while tHum.Health > 0 and Config.AutoSeaEvent do
                            EquipWeapon(Config.SelectedWeapon)
                            StartFastAttack()
                            task.wait(0.1)
                            if tHRP and (tHRP.Position - HumanoidRootPart.Position).Magnitude > 40 then
                                GlobalTween(tHRP.CFrame * CFrame.new(0, 30, 0), 500)
                            end
                        end
                        StopFastAttack()
                    end
                end
            end)
        end
    end)
end

function SeaSystem.StopSeaEvent()
    if Threads.SeaEvent then task.cancel(Threads.SeaEvent); Threads.SeaEvent = nil end
    StopFastAttack()
end

