local function StartFastAttack()
    if Threads.FastAttack then return end
    Threads.FastAttack = task.spawn(function()
        while Config.FastAttack do
            task.wait(Config.AttackDelay)
            pcall(function()
                local tool = Character:FindFirstChildOfClass("Tool")
                if tool then
                    VirtualUser:CaptureController()
                    VirtualUser:ClickButton1(Vector2.new(0, 0), Workspace)
                    if CommF_ then CommF_:FireServer("Combat", "Click") end
                end
            end)
        end
    end)
