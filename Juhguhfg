local TweenTracker = {
    ActiveTween = nil,
    IsMoving = false,
    LastPosition = Vector3.new(0, 0, 0),
    StuckTimer = 0,
    LastCheckTime = 0
}

function GlobalTween(targetCFrame, speed)
    if not targetCFrame or not HumanoidRootPart then return nil end
    if not Humanoid or Humanoid.Health <= 0 then return nil end
    
    speed = speed or Config.FarmTweenSpeed
    
    local distance = (targetCFrame.Position - HumanoidRootPart.Position).Magnitude
    local duration = math.clamp(distance / speed, 0.1, 8)
    
    local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut)
    
    if TweenTracker.ActiveTween then
        TweenTracker.ActiveTween:Cancel()
    end
    
    local tween = TweenService:Create(HumanoidRootPart, tweenInfo, {CFrame = targetCFrame})
    
    TweenTracker.ActiveTween = tween
    TweenTracker.IsMoving = true
    TweenTracker.LastPosition = HumanoidRootPart.Position
    TweenTracker.LastCheckTime = tick()
    TweenTracker.StuckTimer = 0
    
    -- Anti-Stuck System
    if Config.AntiStuckEnabled then
        task.spawn(function()
            while TweenTracker.IsMoving and tween.PlaybackState == Enum.PlaybackState.Playing do
                task.wait(1)
                if not TweenTracker.IsMoving then break end
                if not HumanoidRootPart or not Humanoid or Humanoid.Health <= 0 then break end
                
                local currentPos = HumanoidRootPart.Position
                local distanceMoved = (currentPos - TweenTracker.LastPosition).Magnitude
                
                if distanceMoved < 2 then
                    TweenTracker.StuckTimer = TweenTracker.StuckTimer + 1
                    
                    if TweenTracker.StuckTimer >= 3 then
                        tween:Cancel()
                        TweenTracker.IsMoving = false
                        
                        -- Teleport up and retry
                        pcall(function()
                            HumanoidRootPart.CFrame = HumanoidRootPart.CFrame + Vector3.new(0, 50, 0)
                        end)
                        
                        task.wait(0.3)
                        
                        -- Retry tween
                        if HumanoidRootPart and targetCFrame then
                            local remainingDist = (targetCFrame.Position - HumanoidRootPart.Position).Magnitude
                            local newTween = TweenService:Create(HumanoidRootPart, 
                                TweenInfo.new(math.clamp(remainingDist / speed, 0.1, 8), Enum.EasingStyle.Linear), 
                                {CFrame = targetCFrame})
                            TweenTracker.ActiveTween = newTween
                            TweenTracker.StuckTimer = 0
                            newTween:Play()
                        end
                    end
                else
                    TweenTracker.StuckTimer = 0
                end
                
                TweenTracker.LastPosition = currentPos
            end
        end)
    end
    
    tween.Completed:Connect(function()
        TweenTracker.IsMoving = false
        TweenTracker.StuckTimer = 0
        TweenTracker.ActiveTween = nil
    end)
    
    tween:Play()
    return tween
end

function StopGlobalTween()
    TweenTracker.IsMoving = false
    if TweenTracker.ActiveTween then
        TweenTracker.ActiveTween:Cancel()
        TweenTracker.ActiveTween = nil
    end
end

--// Anti-Cheat Bypass - Fixed
local function SetupAntiCheatBypass()
    pcall(function()
        if not getrawmetatable then return end
        local mt = getrawmetatable(game)
        if not mt then return end
        
        local oldIndex = mt.__index
        local oldNewIndex = mt.__newindex
        
        setreadonly(mt, false)
        
        mt.__index = newcclosure(function(self, key)
            if key == "WalkSpeed" and self:IsA("Humanoid") then
                return 16
            end
            return oldIndex(self, key)
        end)
        
        mt.__newindex = newcclosure(function(self, key, value)
            if key == "CFrame" and self:IsA("BasePart") and self.Name == "HumanoidRootPart" then
                local dist = (value.Position - self.CFrame.Position).Magnitude
                if dist > 1000 then
                    task.spawn(function()
                        task.wait(0.05)
                        oldNewIndex(self, key, value)
                    end)
                    return
                end
            end
            return oldNewIndex(self, key, value)
        end)
        
        setreadonly(mt, true)
    end)
    
    pcall(function()
        if CommF_ then
            local oldInvoke = CommF_.InvokeServer
            CommF_.InvokeServer = function(self, ...)
                local args = {...}
                if #args > 0 and type(args[1]) == "string" then
                    local blockList = {"Check", "Ban", "Report", "Kick"}
                    for _, block in ipairs(blockList) do
                        if args[1]:find(block) then
                            return nil
                        end
                    end
                end
                return oldInvoke(self, ...)
            end
        end
    end)
end

--// Weapon System - Fixed
local function EquipWeapon(weaponType)
    if not Config.AutoEquipWeapon then return nil end
    
    local char = Player.Character
    local backpack = Player:WaitForChild("Backpack")
    if not char or not backpack then return nil end
    
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not humanoid then return nil end
    
    local targetTool = nil
    
    -- Check if already equipped
    local equipped = char:FindFirstChildOfClass("Tool")
    if equipped then
        if weaponType == "Melee" then
            local melees = {"Godhuman", "Sanguine Art", "Dragon Talon", "Electric Claw", "Sharkman Karate", "Death Step", "Superhuman", "Combat", "Black Leg", "Dark Step", "Fishman Karate", "Electro", "Dragon Breath"}
            for _, name in ipairs(melees) do
                if equipped.Name == name then return equipped end
            end
        elseif weaponType == "Sword" then
            local tip = equipped:FindFirstChild("ToolTip")
            if tip and tip.Value == "Sword" then return equipped end
        elseif weaponType == "Blox Fruit" then
            local tip = equipped:FindFirstChild("ToolTip")
            if tip and tip.Value == "Blox Fruit" then return equipped end
        end
    end
    
    -- Find in backpack
    if weaponType == "Melee" then
        local melees = {"Godhuman", "Sanguine Art", "Dragon Talon", "Electric Claw", "Sharkman Karate", "Death Step", "Superhuman", "Dragon Breath", "Electro", "Fishman Karate", "Dark Step", "Black Leg", "Combat"}
        for _, name in ipairs(melees) do
            targetTool = backpack:FindFirstChild(name)
            if targetTool then break end
        end
    elseif weaponType == "Sword" then
        for _, item in pairs(backpack:GetChildren()) do
            if item:IsA("Tool") then
                local tip = item:FindFirstChild("ToolTip")
                if tip and tip.Value == "Sword" then 
                    targetTool = item
                    break 
                end
                local swordNames = {"Sword", "Katana", "Blade", "Wando", "Saddi", "Shisui", "True Triple Katana", "Rengoku", "Saber", "Buddy Sword", "Canvander", "Dark Blade", "Yoru", "Tushita", "Yama", "Cursed Dual Katana", "Hallow Scythe", "Midnight Blade", "Dragon Trident", "Spikey Trident", "Longsword", "Iron Mace", "Shark Saw", "Triple Katana", "Pipe", "Dual-Headed Blade", "Bisento", "Soul Cane", "Koko", "Rengoku", "Slayer Sword", "Dragonheart", "Oni Mask", "Cavander", "Twin Hooks", "Dual Katana", "Jaw Shield", "Gravity Blade", "Saber", "Dark Blade", "Hallow Scythe", "Cursed Dual Katana", "Shark Anchor", "Dragon Trident", "Spikey Trident", "Midnight Blade", "Bisento", "Soul Cane", "Longsword", "Iron Mace", "Shark Saw", "Triple Katana", "Pipe", "Dual-Headed Blade", "Wardens Sword", "Zebra Cap", "Koko", "Rengoku", "Dragon Trident", "Yama", "Tushita", "Cursed Dual Katana", "Dark Blade", "Saber", "Buddy Sword", "Canvander", "Twin Hooks", "Spikey Trident", "Dragon Trident", "Hallow Scythe", "Jaw Shield", "Gravity Blade", "Oni Mask", "Dark Dagger", "Cavander", "Shark Anchor"}
                for _, sName in ipairs(swordNames) do
                    if item.Name:find(sName) then
                        targetTool = item
                        break
                    end
                end
                if targetTool then break end
            end
        end
    elseif weaponType == "Blox Fruit" then
        for _, item in pairs(backpack:GetChildren()) do
            if item:IsA("Tool") then
                local tip = item:FindFirstChild("ToolTip")
                if tip and tip.Value == "Blox Fruit" then 
                    targetTool = item
                    break 
                end
                local fruits = {"Dough", "Dragon", "Leopard", "Kitsune", "Yeti", "Gas", "Spirit", "Venom", "Shadow", "Rumble", "Portal", "Blizzard", "Phoenix", "Buddha", "Light", "Ice", "Flame", "Dark", "Sand", "Smoke", "Spin", "Chop", "Spring", "Bomb", "Spike", "Barrier", "Magma", "Quake", "Gravity", "Love", "Spider", "Sound", "Pain", "Control", "Ghost", "Shadow", "Venom", "Spirit", "Dragon", "Leopard", "Kitsune", "Dough", "T-Rex", "Mammoth", "Gas", "Yeti"}
                for _, fruit in ipairs(fruits) do 
                    if item.Name:find(fruit) then 
                        targetTool = item
                        break 
                    end 
                end
                if targetTool then break end
            end
        end
    end
    
    -- Equip if found
    if targetTool and targetTool.Parent == backpack then
        pcall(function()
            humanoid:EquipTool(targetTool)
        end)
        return targetTool
    end
    
    return targetTool
end

