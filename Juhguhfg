function RaidSystem.AutoStartRaid()
    task.spawn(function()
        if CommF_ then
            pcall(function()
                CommF_:InvokeServer("RaidsNpc", "Select", Config.RaidChip)
            end)
        end
        task.wait(1)
        
        local lobby = Workspace:FindFirstChild("RaidLobby")
        if lobby then
            local startPad = lobby:FindFirstChild("StartPad")
            if startPad then
                GlobalTween(startPad.CFrame, 400)
                task.wait(1)
                
                local clickDetector = startPad:FindFirstChildOfClass("ClickDetector")
                if clickDetector then 
                    pcall(function()
                        fireclickdetector(clickDetector) 
                    end)
                end
            end
        end
    end)
end

function RaidSystem.AutoClearRoom()
    StopThread("RaidClear")
    
    Threads.RaidClear = RunService.Heartbeat:Connect(function()
        if not Config.AutoClearRoom then return end
        
        pcall(function()
            local enemiesFolder = Workspace:FindFirstChild("Enemies")
            if not enemiesFolder then return end
            
            for _, enemy in pairs(enemiesFolder:GetChildren()) do
                if enemy.Name:find("Raid") or enemy.Name:find("Island") then
                    local hum = enemy:FindFirstChild("Humanoid")
                    local hrp = enemy:FindFirstChild("HumanoidRootPart")
                    
                    if hum and hrp and hum.Health > 0 then
                        GlobalTween(hrp.CFrame * CFrame.new(0, 0, -5), 400)
                        
                        while hum.Health > 0 do
                            EquipWeapon(Config.SelectedWeapon)
                            StartFastAttack()
                            task.wait(0.1)
                        end
                    end
                end
            end
        end)
    end)
end

function RaidSystem.StopRaidClear()
    StopThread("RaidClear")
    StopFastAttack()
end

