local MiscSystem = {}

function MiscSystem.StartChestFarm()
    StopThread("ChestFarm")
    
    Threads.ChestFarm = RunService.Heartbeat:Connect(function()
        if not Config.AutoChest then return end
        
        pcall(function()
            for _, v in pairs(Workspace:GetDescendants()) do
                if v.Name:find("Chest") and v:IsA("BasePart") and v.Transparency < 1 then
                    GlobalTween(v.CFrame, 600)
                    task.wait(0.3)
                    
                    local prompt = v:FindFirstChildOfClass("ProximityPrompt")
                    if prompt then 
                        pcall(function()
                            fireproximityprompt(prompt) 
                        end)
                    end
                end
            end
        end)
    end)
end

function MiscSystem.StopChestFarm()
    StopThread("ChestFarm")
end

function MiscSystem.StartFruitSniper()
    StopThread("FruitSniper")
    
    Threads.FruitSniper = RunService.Heartbeat:Connect(function()
        if not Config.AutoFruit then return end
        
        pcall(function()
            local fruits = {"Dough", "Dragon", "Leopard", "Kitsune", "Yeti", "Gas", "Spirit", "Venom", "Shadow", "Rumble", "Portal", "Blizzard", "Phoenix", "Buddha", "Light", "Ice", "Flame", "Dark", "Sand", "Smoke", "Spin", "Chop", "Spring", "Bomb", "Spike", "Barrier", "Magma", "Quake", "Gravity", "Love", "Spider", "Sound", "Pain", "Control", "Ghost"}
            
            for _, v in pairs(Workspace:GetChildren()) do
                if v:IsA("Tool") and v:FindFirstChild("Handle") then
                    local handle = v:FindFirstChild("Handle")
                    local isFruit = false
                    
                    for _, fruit in ipairs(fruits) do 
                        if v.Name:find(fruit) then 
                            isFruit = true
                            break 
                        end 
                    end
                    
                    if isFruit and handle then
                        GlobalTween(handle.CFrame, 600)
                        task.wait(0.5)
                        
                        if HumanoidRootPart then
                            HumanoidRootPart.CFrame = handle.CFrame
                        end
                        task.wait(1)
                        
                        if CommF_ then
                            pcall(function()
                                CommF_:InvokeServer("StoreFruit", v.Name, v)
                            end)
                        end
                        
                        Rayfield:Notify({
                            Title = "Fruit Sniper",
                            Content = "Đã nhặt: " .. v.Name,
                            Duration = 3
                        })
                    end
                end
            end
        end)
    end)
end

function MiscSystem.StopFruitSniper()
    StopThread("FruitSniper")
end

function MiscSystem.StartESP()
    StopThread("ESP")
    
    Threads.ESP = RunService.Heartbeat:Connect(function()
        pcall(function()
            -- Player ESP
            if Config.PlayerESP then
                for _, other in pairs(Players:GetPlayers()) do
                    if other ~= Player and other.Character then
                        local hrp = other.Character:FindFirstChild("HumanoidRootPart")
                        if hrp and not hrp:FindFirstChild("PlayerESP") then
                            -- Box ESP
                            local box = Instance.new("BoxHandleAdornment")
                            box.Name = "PlayerESP"
                            box.Size = Vector3.new(4, 6, 4)
                            box.Color3 = Color3.fromRGB(255, 0, 0)
                            box.AlwaysOnTop = true
                            box.Adornee = hrp
                            box.Parent = hrp
                            
                            -- Name tag
                            local bill = Instance.new("BillboardGui")
                            bill.Name = "PlayerInfo"
                            bill.Size = UDim2.new(0, 100, 0, 50)
                            bill.AlwaysOnTop = true
                            bill.Adornee = hrp
                            
                            local label = Instance.new("TextLabel")
                            label.Text = other.Name
                            label.Size = UDim2.new(1, 0, 0.5, 0)
                            label.BackgroundTransparency = 1
                            label.TextColor3 = Color3.new(1, 1, 1)
                            label.Parent = bill
                            bill.Parent = hrp
                        end
                    end
                end
            end
            
            -- Chest ESP
            if Config.ChestESP then
                for _, v in pairs(Workspace:GetDescendants()) do
                    if v.Name:find("Chest") and v:IsA("BasePart") and not v:FindFirstChild("ChestESP") then
                        local esp = Instance.new("BoxHandleAdornment")
                        esp.Name = "ChestESP"
                        esp.Size = v.Size + Vector3.new(1, 1, 1)
                        esp.Color3 = Color3.fromRGB(255, 215, 0)
                        esp.AlwaysOnTop = true
                        esp.Adornee = v
                        esp.Parent = v
                    end
                end
            end
            
            -- Fruit ESP
            if Config.FruitESP then
                for _, v in pairs(Workspace:GetChildren()) do
                    if v:IsA("Tool") and v:FindFirstChild("Handle") and not v.Handle:FindFirstChild("FruitESP") then
                        local esp = Instance.new("BoxHandleAdornment")
                        esp.Name = "FruitESP"
                        esp.Size = Vector3.new(5, 5, 5)
                        esp.Color3 = Color3.fromRGB(255, 0, 255)
                        esp.AlwaysOnTop = true
                        esp.Adornee = v.Handle
                        esp.Parent = v.Handle
                    end
                end
            end
        end)
        
        task.wait(1)
    end)
end

function MiscSystem.StopESP()
    StopThread("ESP")
end

function MiscSystem.StartAimbot()
    StopThread("Aimbot")
    
    Threads.Aimbot = RunService.Heartbeat:Connect(function()
        if not Config.Aimbot then return end
        
        pcall(function()
            local nearest = nil
            local minDist = math.huge
            
            -- Find nearest player
            for _, other in pairs(Players:GetPlayers()) do
                if other ~= Player and other.Character then
                    local hrp = other.Character:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        local dist = (hrp.Position - HumanoidRootPart.Position).Magnitude
                        if dist < minDist and dist < 200 then
                            minDist = dist
                            nearest = other
                        end
                    end
                end
            end
            
            -- Attack nearest
            if nearest and nearest.Character then
                local targetHRP = nearest.Character:FindFirstChild("HumanoidRootPart")
                if targetHRP then
                    GlobalTween(targetHRP.CFrame * CFrame.new(0, 0, 5), 600)
                    EquipWeapon(Config.SelectedWeapon)
                    StartFastAttack()
                    
                    -- Use skills
                    for _, key in pairs({"Z", "X", "C", "V"}) do
                        VirtualInputManager:SendKeyEvent(true, key, false, game)
                        task.wait(0.05)
                        VirtualInputManager:SendKeyEvent(false, key, false, game)
                    end
                end
            end
        end)
    end)
end

function MiscSystem.StopAimbot()
    StopThread("Aimbot")
    StopFastAttack()
end

