--// Auto Farm - Fixed
local function StartAutoFarm()
    StopThread("AutoFarm")
    
    Threads.AutoFarm = RunService.Heartbeat:Connect(function()
        if not Config.AutoFarmLevel then return end
        if not HumanoidRootPart then return end
        
        pcall(function()
            -- Check if player data exists
            local playerData = Player:FindFirstChild("Data")
            if not playerData then return end
            
            local levelValue = playerData:FindFirstChild("Level")
            if not levelValue then return end
            
            local level = levelValue.Value
            local quest = GetQuestForLevel(level)
            
            if not quest then 
                task.wait(2)
                return 
            end
            
            -- Check if we need to get new quest
            if not CurrentQuest or CurrentQuest.Level ~= quest.Level then
                StopGlobalTween()
                GlobalTween(quest.NPCPos, 300)
                task.wait(1)
                
                -- Start quest
                if CommF_ then
                    local success = pcall(function()
                        CommF_:InvokeServer("StartQuest", quest.Quest, quest.Level)
                    end)
                    if success then
                        CurrentQuest = quest
                    end
                end
                task.wait(0.5)
                return
            end
            
            -- Find and attack enemies
            local enemies = FindEnemies(CurrentQuest.Enemy)
            if #enemies > 0 then
                local target = enemies[1]
                local tHRP = target:FindFirstChild("HumanoidRootPart")
                local tHum = target:FindFirstChild("Humanoid")
                
                if tHRP and tHum and tHum.Health > 0 then
                    -- Calculate farm position
                    local farmPos = tHRP.CFrame * CFrame.new(0, 0, Config.FarmDistance)
                    local dist = (farmPos.Position - HumanoidRootPart.Position).Magnitude
                    
                    if dist > 10 then
                        GlobalTween(farmPos, Config.FarmTweenSpeed)
                    end
                    
                    -- Equip weapon and look at target
                    EquipWeapon(Config.SelectedWeapon)
                    if Camera then
                        Camera.CFrame = CFrame.new(Camera.CFrame.Position, tHRP.Position)
                    end
                else
                    -- Enemy dead, find next
                    task.wait(0.2)
                end
            else
                -- No enemies found, wait
                task.wait(0.5)
            end
        end)
    end)
end

local function StopAutoFarm()
    StopThread("AutoFarm")
    StopGlobalTween()
    StopFastAttack()
    StopBringMobs()
end

