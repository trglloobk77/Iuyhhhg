local CurrentQuest = nil

local function GetQuestForLevel(level)
    local quest = nil
    for _, q in ipairs(QuestData) do
        if level >= q.Level then quest = q end
    end
    return quest
end

local function FindEnemies(enemyName)
    local enemies = {}
    
    -- Check Workspace.Enemies
    if Workspace:FindFirstChild("Enemies") then
        for _, enemy in pairs(Workspace.Enemies:GetChildren()) do
            if enemy.Name == enemyName then
                local hum = enemy:FindFirstChild("Humanoid")
                local hrp = enemy:FindFirstChild("HumanoidRootPart")
                if hum and hrp and hum.Health > 0 then 
                    table.insert(enemies, enemy) 
                end
            end
        end
    end
    
    -- Check Workspace.Characters (for players)
    if Workspace:FindFirstChild("Characters") then
        for _, enemy in pairs(Workspace.Characters:GetChildren()) do
            if enemy.Name == enemyName then
                local hum = enemy:FindFirstChild("Humanoid")
                local hrp = enemy:FindFirstChild("HumanoidRootPart")
                if hum and hrp and hum.Health > 0 then 
                    table.insert(enemies, enemy) 
                end
            end
        end
    end
    
    -- Sort by distance
    if HumanoidRootPart then
        table.sort(enemies, function(a, b)
            local aPos = a:FindFirstChild("HumanoidRootPart") and a.HumanoidRootPart.Position or Vector3.new(0,0,0)
            local bPos = b:FindFirstChild("HumanoidRootPart") and b.HumanoidRootPart.Position or Vector3.new(0,0,0)
            return (aPos - HumanoidRootPart.Position).Magnitude < (bPos - HumanoidRootPart.Position).Magnitude
        end)
    end
    
    return enemies
end

