--// Threads Management
local Threads = {}
local function StopThread(name)
    if Threads[name] then
        Threads[name]:Disconnect()
        Threads[name] = nil
    end
end

local function StopAllThreads()
    for name, thread in pairs(Threads) do
        if thread then
            pcall(function()
                if typeof(thread) == "RBXScriptConnection" then
                    thread:Disconnect()
                elseif typeof(thread) == "thread" then
                    task.cancel(thread)
                end
            end)
        end
    end
    Threads = {}
end

